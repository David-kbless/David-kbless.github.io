@page "/skills"

<!-- ============================================================
     SKILLS - buildings.jpg en fond pleine page
     Les catégories flottent par-dessus l'image
     ============================================================ -->
<div class="fullbg-page bg-buildings">

    <!-- En-tête sur fond sombre -->
    <div class="page-header fullbg-header">
        <span class="eyebrow">Expertise</span>
        <h1>Compétences</h1>
        <p>Langages, modèles quantitatifs et outils que j'utilise au quotidien.</p>
    </div>

    <!-- Grille des catégories -->
    <div class="skills-page">
        <div class="skills-grid">

            <!-- Catégorie 1 : Langages de programmation -->
            <div class="skills-category">
                <div class="skills-category-header">
                    <div class="skills-category-icon">⌨</div>
                    <h2>Langages de programmation</h2>
                </div>
                <ul class="skills-list">
                    <li>Python</li>
                    <li>TypeScript</li>
                    <li>C#</li>
                    <li>C</li>
                    <li>Java</li>
                    <li>SQL</li>
                    <li>R</li>
                </ul>
            </div>

            <!-- Catégorie 2 : Finance quantitative -->
            <div class="skills-category">
                <div class="skills-category-header">
                    <div class="skills-category-icon">◈</div>
                    <h2>Finance Quantitative</h2>
                </div>
                <ul class="skills-list">
                    <li>Modèle Black-Scholes</li>
                    <li>Simulation Monte Carlo</li>
                    <li>Optimisation Markowitz</li>
                    <li>Gestion des risques</li>
                    <li>Pricing d'options</li>
                </ul>
            </div>

            <!-- Catégorie 3 : Technologies et outils -->
            <div class="skills-category">
                <div class="skills-category-header">
                    <div class="skills-category-icon">⚙</div>
                    <h2>Technologies &amp; Outils</h2>
                </div>
                <ul class="skills-list">
                    <li>.NET / Blazor</li>
                    <li>ASP.NET Core / API REST</li>
                    <li>Angular / PrimeNG</li>
                    <li>Entity Framework Core</li>
                    <li>PostgreSQL</li>
                    <li>NumPy / Pandas</li>
                    <li>Scikit-learn / SciPy</li>
                    <li>Qiskit</li>
                    <li>Matplotlib</li>
                    <li>Git</li>
                    <li>Excel &amp; VBA</li>
                </ul>
            </div>

            <div class="skills-category">
                <div class="skills-category-header">
                    <div class="skills-category-icon">☁</div>
                    <h2>Cloud, DevOps &amp; Qualité</h2>
                </div>
                <ul class="skills-list">
                    <li>AWS ECS / Amazon ECR / RDS</li>
                    <li>Azure Pipelines</li>
                    <li>Docker / Podman Compose</li>
                    <li>OIDC / Secrets Manager</li>
                    <li>xUnit / Jest / tests d'intégration</li>
                    <li>CI/CD et documentation technique</li>
                </ul>
            </div>

        </div>
    </div>

</div>
